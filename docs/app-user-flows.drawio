        <mxCell id="category" value="Choose design category" style="rhombus;whiteSpace=wrap;html=1;fillColor=#172554;strokeColor=#3B82F6;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="730" y="115" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="name" value="NAME PENDANT&lt;br&gt;Text • style • finish&lt;br&gt;emblem • size • metals • stone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#172554;strokeColor=#60A5FA;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="690" y="280" width="210" height="100" as="geometry"/></mxCell>
