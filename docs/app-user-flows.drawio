  <diagram id="shopper" name="2 - Shopper QR design flow">
    <mxGraphModel dx="1420" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="SHOPPER FLOW — QR CODE TO AUTOMATIC QUOTE REQUEST" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=24;fontColor=#F4E8D0;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="note" value="Important: there is no separate ‘Request Quote’ action. Eligibility creates the private draft automatically." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#312E16;strokeColor=#F59E0B;fontColor=#FDE68A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="20" width="500" height="50" as="geometry"/></mxCell>
