DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@...pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@...pooler.supabase.com:5432/postgres"
# Optional archived SQLite source used only by migration scripts. Defaults to prisma/dev.db.
SQLITE_SOURCE_DATABASE_URL=""
GOOGLE_API_KEY="your_google_api_key"
WAVESPEED_API_KEY="your_wavespeed_api_key"
VIDEO_ACCESS_CODE="ID8"
NAME_PROMPT_MODE="json"
VIDEO_DURATION_SECONDS=7
APP_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
GENERATED_IMAGE_DIR="public/generated"

# Optional local-only inputs for `npm run auth:provision-dev-owner`.
# Do not commit a real password. Set DEV_OWNER_PASSWORD only in `.env.local`
# or inline for the provisioning command.
DEV_OWNER_EMAIL=""
DEV_OWNER_PASSWORD=""
DEV_OWNER_ACCOUNT_SLUG="dev"
DEV_OWNER_STORE_NAME="Development Store"

# Optional production media storage.
# If all required R2 vars are present, new generated images/videos are written to R2 instead of GENERATED_IMAGE_DIR.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="mvp-jewelry-media"
R2_ENDPOINT=""
R2_PUBLIC_BASE_URL=""
